# Dashboard → API keys → Create API key (a "sending" key is enough).
SENDPOSITORY_API_KEY=sp_your_api_key

# Must be on a domain you have verified under Dashboard → Domains.
SENDPOSITORY_FROM="Acme <hello@mail.yourdomain.com>"

# Optional: only for the webhook route. Dashboard → Webhooks → Add an endpoint.
SENDPOSITORY_WEBHOOK_SECRET=
